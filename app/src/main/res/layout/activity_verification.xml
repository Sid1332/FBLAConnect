<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_bg">

    <!-- World Map Watermark Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:alpha="1"
        android:scaleType="fitCenter"
        android:scaleX="3"
        android:scaleY="3"
        android:src="@drawable/world_map_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/raleway"
            android:text="Email Verification"
            android:textColor="@color/fbla_gold"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVerificationMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:fontFamily="@font/raleway"
            android:text="We sent a verification code to:\nyour-email@example.com"
            android:textAlignment="center"
            android:textColor="@color/text_grey_dark"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editVerificationCode"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/login_input_background"
            android:fontFamily="@font/raleway"
            android:hint="Enter 6-digit code"
            android:inputType="number"
            android:maxLength="6"
            android:padding="16dp"
            android:textAlignment="center"
            android:textColor="@color/text_grey_dark"
            android:textSize="24sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_background_gold"
            android:fontFamily="@font/raleway"
            android:text="VERIFY"
            android:textColor="@color/button_text_grey"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResendCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/raleway"
            android:text="Resend Code"
            android:textColor="@color/fbla_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/header_grey"
            android:orientation="horizontal"
            android:padding="24dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_pink" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/raleway"
                    android:text="Welcome"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/raleway"
                    android:text="Dani Martinez"
                    android:textColor="#4A4A4A"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Dashboard View -->
        <ScrollView
            android:id="@+id/dashboardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/raleway"
                    android:text="Categories"
                    android:textColor="#5C5C70"
                    android:textSize="22sp"
                    android:layout_marginBottom="20dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <LinearLayout
                        android:id="@+id/categoryRegistration"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Registration" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryCompetition"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/btn_star" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Competition" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryEvents"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_today" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Events" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryNews"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_report_image" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="News" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryResources"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Resources" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categorySocial"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/stat_notify_chat" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Social" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Add Event (Admin Only) -->
                    <LinearLayout
                        android:id="@+id/categoryAddEvent"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_add" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Add Event" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Post News (Admin Only) -->
                    <LinearLayout
                        android:id="@+id/categoryPostNews"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/category_item_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_info_details" app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/raleway" android:text="Post News" android:textColor="@color/white" android:textSize="12sp" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Fragment Container for Add Event, Post News, etc. -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Old Calendar View Container -->
        <LinearLayout
            android:id="@+id/calendarContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">
            <CalendarView android:id="@+id/calendarView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <TextView android:id="@+id/eventDetailsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textSize="16sp" android:text="👆 Select a date to view events" />
            </ScrollView>
        </LinearLayout>

        <!-- Old Content Area (for Profile, News, Resources) -->
        <ScrollView
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/contentText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="40dp" android:textSize="18sp" android:text="Loading..." />
                <LinearLayout android:id="@+id/socialMediaButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="20dp" android:visibility="gone">
                    <Button android:id="@+id/btnInstagram" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📷 IG" android:layout_margin="5dp" android:backgroundTint="@color/fbla_blue" />
                    <Button android:id="@+id/btnTwitter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🐦 TW" android:layout_margin="5dp" android:backgroundTint="@color/fbla_blue" />
                    <Button android:id="@+id/btnFacebook" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="👍 FB" android:layout_margin="5dp" android:backgroundTint="@color/fbla_blue" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:text="Logout"
                    android:backgroundTint="@color/fbla_blue" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/nav_dark"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>
</RelativeLayout>